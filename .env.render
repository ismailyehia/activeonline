APP_NAME="نظام الخطط السنوية"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com

# ─── Aiven MySQL ───
DB_CONNECTION=mysql
DB_HOST=your-host.aiven.io
DB_PORT=12345
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your-password
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# ─── Session & Cache (database = works on Render) ───
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ─── Logging (stderr = shows in Render dashboard) ───
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ─── Security ───
SESSION_SECURE_COOKIE=true
