# ================================================================
#  إعدادات الإنتاج — انسخ هذا الملف باسم .env داخل مجلد ymd-plans
#  واملأ كل قيمة مكتوب بجانبها «املأ». لا تشارك ملف .env مع أحد.
# ================================================================

APP_NAME="نظام الخطط السنوية"
APP_ENV=production
APP_DEBUG=false
# يُولَّد على الخادم: php artisan key:generate  (لا تنسخه من أي مكان آخر)
APP_KEY=
# املأ: رابط الموقع الكامل بـ https ومن دون / في النهاية
APP_URL=https://YOUR-DOMAIN.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Istanbul
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ---------- قاعدة MySQL (من لوحة الاستضافة) ----------
DB_CONNECTION=mysql
# املأ: غالبًا localhost في الاستضافة المشتركة
DB_HOST=localhost
DB_PORT=3306
# املأ: اسم قاعدة البيانات واسم مستخدمها كما أنشأتهما في اللوحة
DB_DATABASE=
DB_USERNAME=
# املأ
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------- الجلسات والذاكرة المؤقتة ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ---------- التنبيهات اليومية ----------
# اتركه false إن أضفت مهمة cron (موصى به). اجعله true فقط إن لم تتوفر cron.
ALERTS_RUN_ON_REQUEST=false

# ---------- البريد (غير مستخدم حاليًا في النظام) ----------
MAIL_MAILER=log

# ---------- إنشاء مدير النظام (اختياري) ----------
# الطريقة الموصى بها: php artisan admin:create  (تطلب كلمة المرور مخفية)
# إن استخدمت db:seed لإنشائه فاملأ السطرين ثم احذف ADMIN_PASSWORD فورًا بعد التشغيل.
ADMIN_EMAIL=
ADMIN_PASSWORD=
